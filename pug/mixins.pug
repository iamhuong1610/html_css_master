mixin tourItem(image, price, title, review, reviewCount, duration, tourPrice)
    .tour
        .tour-top
            img.tour-image(src= image, alt='this-is-image')
            span.tour-price= price
        .tour-content
            h2.tour-title= title
            .tour-rating
                .tour-review
                    .tour-star
                        img(src='./images/star.png', alt='tour-rating')
                    .tour-review-count
                        span= review 
                            |   (#{reviewCount} reviews)
                span.tour-duration
                    | Duration: #{duration} hours
            a.tour-button(target='_blank', rel='noopener noreferrer', href='https://www.youtube.com/watch?v=4g_AgjhYyaw')
                | Tours Price $#{tourPrice}

mixin popularItem()
    .popular-item 
        .popular-image
            .popular-overlay
            img(src="https://images.unsplash.com/photo-1472396961693-142e6e269027?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8bmF0dXJlfGVufDB8fDB8fHww",alt="unplash").popular-img
            span.popular-label Must See
        .popular-content
            span.popular-time Sep 28 10:00 AM - 1:00 PM
            h3.popular-title  The Grand Palace
            .popular-review 
                img(src ="images/star.png" alt="star")
                span 4.8 (12 reviews)
